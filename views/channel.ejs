<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IboCord</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="flex h-screen overflow-hidden bg-gray-800 text-white">

    <!-- Sol Sidebar -->
<%- include("./layouts/sidebar.ejs") %>

<div id="main" class="flex flex-grow h-screen">
    <!-- Kanal Listesi -->
     
    <div id="channel-bar" class="bg-gray-900 w-60 p-5">
        <%- include("./components/left-bottom.ejs") %>

        <h2 style="text-align: center;"><%- guild.name %></h2>
        <h4 style="text-align: center;"><%- guild.inviteCode ? guild.inviteCode : 'Sunucunun Davet Kodu Yok.' %></h4>

        <% if(guild.ownerID === user.id) { %> 
            <label class="text-2xl float-right cursor-pointer" onclick="openCreateChannelModal()" title="Kanal Oluştur">+</label>
        <% } %>


        <div class="space-y-2 mt-10">
            <% channels.forEach(channel => { %> 
                <% if(channel.type == 0) { %> 
                    <div class="channel bg-gray-700 hover:bg-gray-600 rounded-md p-2 cursor-pointer transition duration-200" onclick="location.assign('/channels/<%- guild.id %>/<%- channel.id %>')">
                        <span class="text-white">✍ <%- channel.name %></span>
                    </div>                
                    <% } %> 
                <% if(channel.type == 1) { %>
                <div class="channel bg-gray-700 hover:bg-gray-600 rounded-md p-2 cursor-pointer transition duration-200" onclick="joinVoiceChannel('<%- channel.id %>')" onmouseover="showVoiceUsers('<%- channel.id %>')">

                    <span class="text-white">🔉 <%- channel.name %>
                        <ul id="voiceUsers-<%- channel.id %>">

                        </ul>
                    </span>
                </div>
                <audio id="localAudio" autoplay muted></audio>
                <audio id="remoteAudio" autoplay></audio>
                <audio id="joinEffect" src="/join.mp3"></audio>
                <audio id="leaveEffect" src="/leave.mp3"></audio>

            <% } %>
            <% }); %> 
        </div>
        
  </div>

        <!-- Chat Alanı -->
        <div id="chat-area" class="flex flex-col flex-grow bg-gray-800">
            <div id="chat-header" class="flex items-center bg-gray-900 p-2 border-b border-gray-700">
                ✍ <%- channel.name %>
            </div>
            <div id="messages-" class="flex-grow p-2 overflow-y-auto">

                <ul id="messages">
                </ul>       
                    
             </div>
            <div id="message-input" class="flex p-2 bg-gray-700">
                <input id="input-field" type="text" class="flex-grow p-2 bg-gray-800 text-white rounded mr-2" placeholder="Mesaj yaz...">
                <button id="send-btn" class="bg-blue-600 p-2 rounded hover:bg-blue-500 transition duration-300">Gönder</button>
            </div>
        </div>

        <!-- Sağ Kullanıcı Listesi -->
        <div id="user-list" class="bg-gray-900 w-60 p-5 border-l border-gray-700">
            <% guild.members.forEach(x => { %>
                <div class="user" data-id="<%- x.id %>"> <!-- Kullanıcı ID'sini sakla -->
                    <div class="user-status">
                        <span class="status"></span> <!-- Kullanıcı durumunu burada göstereceğiz -->
                    </div>
                    <img src="<%- x.profilePhoto %>" alt="<%- x.displayName %>" class="rounded-full h-8 w-8">
                    <span><%- x.username %></span>
                </div>
            <% }); %>
        </div>
        
        

        
        <!-- Diğer kullanıcılar buraya eklenebilir -->
    </div>
</div>

</body>
</html>

<style>
            .user {
            padding: 10px;
            margin-bottom: 10px;
            background-color: #40444b;
            border-radius: 5px;
            display: flex;
            align-items: center;
        }

        .user-status-online {
            width: 10px;
            height: 10px;
            background-color: #43b581;
            border-radius: 50%;
            margin-right: 10px;
        }
        .user-status-offline {
            width: 10px;
            height: 10px;
            background-color: #222423;
            border-radius: 50%;
            margin-right: 10px;
        }
</style>
<%- include("./layouts/createChannelModal.ejs") %>    
<%- include("./components/heartbeat.ejs") %>


<script src="https://cdn.socket.io/4.7.5/socket.io.min.js"></script>
        

<script>
    function fetchUserStatus(userElement) {
        const userId = userElement.getAttribute('data-id');

        fetch(`/status/${userId}`)
            .then(response => response.json())
            .then(data => {
                const statusElement = userElement.querySelector('.status');
                const userStatusDiv = userElement.querySelector('.user-status');

                if (data.status) {
                    if (data.status === 'active') {
                        userStatusDiv.classList.remove('user-status-offline');
                        userStatusDiv.classList.add('user-status-online');  // Offline sınıfını kaldır
                    } else {
                        userStatusDiv.classList.add('user-status-offline'); // Offline sınıfını ekle
                        
                    }
                } else {
                    userStatusDiv.classList.remove('user-status-online'); // Offline sınıfını ekle
                    userStatusDiv.classList.add('user-status-offline'); // Offline sınıfını ekle
                }
            })
            .catch(error => {
                console.error('Error fetching status:', error);
            });
    }

    // İlk durum kontrolü ve ardından her 5 saniyede bir kontrol et
    const userElements = document.querySelectorAll('.user');
    userElements.forEach(userElement => {
        fetchUserStatus(userElement); // İlk durumu kontrol et
        setInterval(() => fetchUserStatus(userElement), 5000); // 5 saniyede bir durumu kontrol et
    });
</script>
<script>
    
// Bildirim izni isteme
window.addEventListener('load', () => {
    if(!localStorage.getItem('notperm')) {
        Notification.requestPermission().then((permission) => {
            if (permission === 'granted') {
                // İzin verildiyse bildirim göster
                localStorage.setItem('notperm', true)
            }
        });
        notifyButton.remove();
    }
});

// Bildirim gösterme fonksiyonu
    const socket = io()
    
    const user = "<%= JSON.stringify(user) %>".replace(/&#34;/g, '"')  // &#34; yerine " kullan
    const channel = JSON.parse('<%- JSON.stringify(channel) %>');
    const guild = JSON.parse('<%- JSON.stringify(guild) %>');
    const message = "<%= JSON.stringify(messages) %>".replace(/&#34;/g, '"')  // &#34; yerine " kullan
    .replace(/&#39;/g, "'")  // Eğer varsa &#39; yerine ' kullan
    .replace(/&amp;/g, '&')   // Eğer varsa &amp; yerine & kullan
    .replace(/&lt;/g, '<')    // Eğer varsa &lt; yerine < kullan
    .replace(/&gt;/g, '>'); ; // Kullanıcıyı JSON olarak al
    const form = document.getElementById('form');
    const input = document.getElementById('input-field')
    const messages = document.getElementById('messages');
    const sendbtn = document.getElementById('send-btn')

    window.onload = () => {
        setTimeout(() => {
            document.getElementById('messages').scrollIntoView({ behavior:"smooth", block:"end" });            
