socket.on('offer', async (data) => {
    peerConnection = new RTCPeerConnection(config);

    // Yeni yöntem: addTrack
    localStream.getTracks().forEach(track => {
        peerConnection.addTrack(track, localStream);
    });

    peerConnection.onicecandidate = (event) => {
        if (event.candidate) {
            socket.emit('ice-candidate', { channelID, candidate: event.candidate });
        }
    };

    // Yeni yöntem: ontrack
    peerConnection.ontrack = (event) => {
        remoteAudio.srcObject = event.streams[0];
    };

    await peerConnection.setRemoteDescription(new RTCSessionDescription(data.offer));

    const answer = await peerConnection.createAnswer();
    await peerConnection.setLocalDescription(answer);

    socket.emit('answer', { channelID, answer });
});

socket.on('answer', async (data) => {
    await peerConnection.setRemoteDescription(new RTCSessionDescription(data));
});

socket.on('ice-candidate', async (data) => {
    console.log('Received ICE candidate:', data); // Geliştirici notu: Gelen ICE candidate'ı kontrol edin

    try {
        // data.candidate alanının geçerli bir nesne olduğundan emin olun
        if (data.candidate) {
            await peerConnection.addIceCandidate(new RTCIceCandidate(data.candidate));
        } else {
            console.error('Geçersiz ICE candidate alındı:', data);
        }
    } catch (e) {
        console.error('ICE Candidate eklenirken hata: ', e);
    }
});

socket.on('userLeft', (user) => {
    console.log(user);
    setTimeout(function() {
        leaveEffect.play();
    }, 2000)
})
