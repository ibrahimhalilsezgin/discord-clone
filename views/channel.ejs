    };
    input.addEventListener('keydown', (key) => {
        if(key.key == 'Enter') {
            if(input. value) {
                socket.emit('messageCreate', {
                    user: JSON.parse(user),
                    guild: guild,
                    channel: channel,
                    content: input.value
                });
            input.value = '';
            messages.scrollIntoView({ behavior:"smooth", block:"end" });
                
        }
    } 
})

    sendbtn.addEventListener('click', (ev) => {
        if(input. value) {
            socket.emit('messageCreate', {
                user: JSON.parse(user),
                guild: guild,
                channel: channel,
                content: input.value
            });
            input.value = '';
            messages.scrollIntoView({ behavior:"smooth", block:"end" });
        }
    })
// Mesaj oluşturulduğunda
socket.on('messageCreate', (msg) => { 
    console.log(msg.channel.id === "<%- channel.id %>")
    if(!msg.channel.id === "<%- channel.id %>") return "";
    const item = document.createElement('li');
    item.innerHTML = `
        <li>

                    <div class="flex items-start space-x-4 p-4 bg-gray-800 rounded-lg max-w-sm">
                     
                        <img src="${msg.user.profilePhoto ? msg.user.profilePhoto : 'https://via.placeholder.com/35'}" alt="ibo" class="w-8 h-8 rounded-full object-cover">
                      
                     
                        <div>
                     
                          <div class="flex items-center space-x-2">
                            <span class="font-bold text-white">${msg.user.username}</span>
                            <span class="text-sm text-gray-400">${Date()}</span>
                          </div>
                     
                          <p class="text-white">${msg.content}</p>
                        </div>
                      </div>
                      
                </li>`; // Mesaj içeriğini ayarla
                messages.appendChild(item); // Mesajı listeye ekle
                messages.scrollIntoView({ behavior:"smooth", block:"end" });
                new Notification('<%- guild.name %> ~ <%- channel.name %>', { body:msg.content });
                console.log(msg.user.id === "<%- user.id %>")
});

// Sayfa yüklendiğinde
window.onload = () => {
    const messagesList = document.getElementById('messages');
    messagesList.scrollIntoView({ behavior:"smooth", block:"end" });            
    const messageString = "<%= JSON.stringify(messages) %>".replace(/&#34;/g, '"'); // &#34; yerine " kullan
    
    let messages;
    try {
        messages = JSON.parse(messageString); 
    } catch (error) {
        console.error("JSON parse hatası:", error.message);
        return; // Hata varsa işleme devam etme
    }

    // Mesajları listeye ekle
    messages.forEach(message => {
        const item = document.createElement('li');
        item.innerHTML = `
        <li>

                    <div class="flex items-start space-x-4 p-4 bg-gray-800 rounded-lg max-w-sm">
                     
                        <img src="${message.author.profilePhoto ? message.author.profilePhoto : 'https://via.placeholder.com/35'}" alt="ibo" class="w-8 h-8 rounded-full object-cover">
                      
                     
                        <div>
                     
                          <div class="flex items-center space-x-2">
                            <span class="font-bold text-white">${message.author.username}</span>
                            <span class="text-sm text-gray-400">${message.createdAt}</span>
                          </div>
                     
                          <p class="text-white">${message.content}</p>
                        </div>
                      </div>
                      
                </li>`; // Mesajı yazarın kullanıcı adı ile göster
                
                messagesList.appendChild(item); // Listeye ekle
                messagesList.scrollIntoView({ behavior:"smooth", block:"end" });            

    });
    
    // Sayfanın en altına kaydır
};
const localAudio = document.getElementById('localAudio');
const remoteAudio = document.getElementById('remoteAudio');
const channelIdInput = document.getElementById('channelId');
const joinEffect = document.getElementById('joinEffect');
const leaveEffect = document.getElementById('leaveEffect');

let localStream;
let peerConnection;
let channelID;
let showed = 0;
let muted = false;
const config = {
    iceServers: [
        { urls: 'stun:stun.l.google.com:19302' } // STUN sunucusu
    ]
};

document.getElementById('mute').addEventListener('click', (event) => {
    if(!localStream) return;
    if(muted) {
        localStream.getAudioTracks().forEach(track => track.enabled = true) 
        document.getElementById('mute').innerHTML = '<i class="fa-solid fa-microphone"></i>'
        muted = false    
    } 
    else {
        localStream.getAudioTracks().forEach(track => track.enabled = false) 
        document.getElementById('mute').innerHTML = '<i class="fa-solid fa-microphone-slash"></i>'
        muted = true
    }
    console.log(muted)
})

document.getElementById('deafen').addEventListener('click', (event) => {
    if(!localStream) return;
    if(muted) {
        document.getElementById('remoteAudio').muted = false
                document.getElementById('deafen').innerHTML = '<i class="fa-solid fa-headphones"></i>'
        muted = false    
    } 
    else {
        document.getElementById('remoteAudio').muted = true
        document.getElementById('deafen').innerHTML = '<i class="fas fa-volume-mute"></i>'
        muted = true
    }
    console.log(muted)
})

function joinVoiceChannel(id) {
    channelID = id;
     // Kullanıcı bilgileri
    if (channelID) {
        socket.emit('joinChannel', { channelID, username: "<%- user.username %>" });
        console.log(`Kanala katıldın: ${channelID}`);
        console.log()
        joinEffect.play()
        let item = document.createElement('li');
        item.textContent = '<%- user.username %>'; // Kullanıcı adını ekle
        document.getElementById('voiceUsers-' + channelID).appendChild(item);
    }
        // Sunucudan "userJoined" olayı ile yeni kullanıcı bilgisi alındığında
        socket.on('userJoined', ({ userId, username }) => {
            console.log(`${username} (${userId}) kanala katıldı.`);
            
            // Kullanıcıyı HTML listesine ekleme
            let item = document.createElement('li');
            if(username == "<%- user.username %>")  return;
            item.textContent = username; // Kullanıcı adını ekle
            document.getElementById('voiceUsers-' + channelID).appendChild(item);
        });
    setTimeout(async () => {
        localStream = await navigator.mediaDevices.getUserMedia({ audio: true });
        localAudio.srcObject = localStream;

        peerConnection = new RTCPeerConnection(config);
        
        // Yeni yöntem: addTrack
        localStream.getTracks().forEach(track => {
            peerConnection.addTrack(track, localStream);
        });

        peerConnection.onicecandidate = (event) => {
            if (event.candidate) {
                socket.emit('ice-candidate', { channelID, candidate: event.candidate });
            }
        };

        // Yeni yöntem: ontrack
        peerConnection.ontrack = (event) => {
            remoteAudio.srcObject = event.streams[0];
        };

        const offer = await peerConnection.createOffer();
        await peerConnection.setLocalDescription(offer);

        socket.emit('offer', { channelID, offer });
    }, 1500);
}
