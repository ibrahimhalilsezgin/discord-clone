    <div id="current-user" class="flex items-center bg-gray-900 p-4 absolute bottom-0 left-0 w-60">
        <img src="<%- user.profilePhoto %>" alt="User" class="w-12 h-12 rounded-full mr-2">
        <span class="font-bold"><%- user.username %></span>        
            <span class="float-right ml-32 cursor-pointer text-2xl" title="mute" id="mute"><i class="fa-solid fa-microphone"></i></span>
            <span class="float-right ml-4 cursor-pointer text-2xl" title="deafen" id="deafen" ><i class="fa-solid fa-headphones"></i></span>
            <span class="float-right ml-4 cursor-pointer text-2xl" title="settings" onclick="openSettingsModal()"><i class="fa-solid fa-gear"></i></span>
    </div>
