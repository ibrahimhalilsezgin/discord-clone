<div id="create-guild-modal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden">
    <div class="container bg-black p-6 rounded shadow-lg w-96">
        <div class="p-6 rounded shadow-lg w-96">
            <h2 class="text-white mb-4">Sunucu Oluştur</h2>
            <form id="form" action="/channels/createGuild" method="post">
                <label class="text-white">Sunucu Adı gir</label><br>
                <input type="text" minlength="1" required name="guildName" class="mt-2 p-2 bg-gray-800 text-white border border-gray-600 rounded" placeholder="Sunucu Adı"><br>
                <input type="submit" value="Oluştur" class="mt-2 bg-blue-600 text-white p-2 rounded hover:bg-blue-500 transition duration-300 cursor-pointer">
            </form>
        </div>
        <div class="p-6 rounded shadow-lg w-96">
            <h2 class="text-white mb-4">Sunucuya Katıl</h2>
            <form id="form" action="/channels/joinGuild" method="post">
                <label class="text-white">Sunucu Davet Linkini Gir</label><br>
                <input type="text" minlength="1" required name="guildInviteCode" class="mt-2 p-2 bg-gray-800 text-white border border-gray-600 rounded" placeholder="Sunucu Kodu"><br>
                <input type="submit" value="Katıl" class="mt-2 bg-blue-600 text-white p-2 rounded hover:bg-blue-500 transition duration-300 cursor-pointer">
            </form>
        </div>
        <button type="button" onclick="closeCreateGuildModal()" class="mt-2 w-full text-center text-red-400 hover:text-red-300">İptal</button>
    </div>
    
    
</div>