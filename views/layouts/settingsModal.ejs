<!-- Settings Modal -->
<div id="settingsModal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-60 z-50 hidden">
  <div class="bg-gray-800 text-white rounded-lg shadow-lg w-full h-full lg:w-3/4 lg:h-5/6 overflow-hidden">
    <div class="flex h-full">
      <!-- Sidebar -->
      <div class="bg-gray-900 w-64 p-4 space-y-4">
        <input class="w-full p-2 rounded bg-gray-700 text-sm text-white" type="text" placeholder="Ara">
        <div class="text-xs uppercase text-gray-400">Kullanıcı Ayarları</div>
        <ul class="space-y-2">
          <li class="text-sm font-medium text-gray-200 hover:bg-gray-700 p-2 rounded cursor-pointer">Hesabım</li>
          <li class="text-sm font-medium text-gray-200 hover:bg-gray-700 p-2 rounded cursor-pointer">Profiller</li>
          <li class="text-sm font-medium text-gray-200 hover:bg-gray-700 p-2 rounded cursor-pointer">Gizlilik ve Güvenlik</li>
          <li class="text-sm font-medium text-gray-200 hover:bg-gray-700 p-2 rounded cursor-pointer">Aile Merkezi</li>
          <li class="text-sm font-medium text-gray-200 hover:bg-gray-700 p-2 rounded cursor-pointer">Bağlantılar</li>
        </ul>
      </div>

      <!-- Main Content -->
      <div class="flex-1 bg-gray-800 p-6 overflow-y-auto">
        <!-- Header -->
        <div class="flex justify-between items-center border-b border-gray-700 pb-4">
          <h2 class="text-xl font-semibold">Hesabım</h2>
          <button class="text-gray-400 hover:text-gray-200 focus:outline-none" onclick="closeSettingsModal()">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Account Section -->
        <div class="mt-6 space-y-6">
          <div class="flex items-center space-x-4">
            <img src="<%- user.profilePhoto %>" class="rounded-full w-16 h-16 cursor-pointer hover:shadow-2xl hover:shadow-white" alt="Avatar" onclick="openEditPPModal()">
            <div>
              <h3 class="text-lg font-semibold"><%- user.displayName %></h3>
              <p class="text-gray-400"><%- user.username %></p>
            </div>
            <button class="ml-auto bg-blue-600 text-white px-3 py-2 rounded-lg hover:bg-blue-700" onclick="openEditDisplayNameModal()">Kullanıcı Profilini Düzenle</button>
          </div>

          <div class="bg-gray-900 p-4 rounded-lg space-y-4">
            <div class="flex justify-between">
              <span>Görünen Ad: <u><%- user.displayName %></u></span>
              <button class="bg-gray-700 text-gray-400 px-3 py-1 rounded hover:bg-gray-600" onclick="openEditDisplayNameModal()">Düzenle</button>
            </div>
            <div class="flex justify-between">
              <p>Kullanıcı Adı: <u><%- user.username %></u></p>
              <button class="bg-gray-700 text-gray-400 px-3 py-1 rounded hover:bg-gray-600" onclick="openEditUsernameModal()">Düzenle</button>
            </div>
            <div class="flex justify-between">
              <p>E-Posta: <u><%- user.email %></u></p>
              <button class="bg-gray-700 text-gray-400 px-3 py-1 rounded hover:bg-gray-600" onclick="openEditEmailModal()">Düzenle</button>
            </div>
            <div class="flex justify-between">
              <p>Telefon Numarası: 0555 555 55 55</p>
              <button class="bg-gray-700 text-gray-400 px-3 py-1 rounded hover:bg-gray-600">Kaldır</button>
            </div>
          </div>

          <div class="mt-6">
            <h3 class="font-semibold text-lg text-green-500">Şifre ve Doğrulama</h3>
            <button class="bg-gray-700 text-gray-400 px-4 py-2 mt-4 rounded hover:bg-gray-600" onclick="openEditPasswordModal()">Şifreyi Değiştir</button>
            <button class="bg-red-600 text-white px-4 py-2 mt-4 rounded hover:bg-red-700" onclick="location.assign('/auth/logout')">Çıkış Yap</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Modals for Editing -->
<div id="editDisplayNameModal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-60 z-50 hidden">
  <div class="bg-gray-800 text-white rounded-lg shadow-lg p-6 w-full lg:w-1/3">
      <h2 class="text-xl font-semibold mb-4">Görünen Adı Düzenle</h2>
      <form id="displayName">
        <input class="w-full p-2 rounded bg-gray-700 text-sm" type="text" placeholder="Yeni Görünen Ad" id="newDisplayName">
        <div class="flex justify-end mt-4">
            <button class="bg-gray-700 text-gray-400 px-4 py-2 rounded hover:bg-gray-600 mr-2" onclick="closeEditDisplayNameModal()">İptal</button>
            <button class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Kaydet</button>
        </div>
      </form>
      
  </div>
</div>

<div id="editUsernameModal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-60 z-50 hidden">
  <div class="bg-gray-800 text-white rounded-lg shadow-lg p-6 w-full lg:w-1/3">
      <h2 class="text-xl font-semibold mb-4">Kullanıcı Adını Düzenle</h2>
      <form id="username">
        <input class="w-full p-2 rounded bg-gray-700 text-sm" type="text" placeholder="Yeni Kullanıcı Adı" id="newUsername">
        <div class="flex justify-end mt-4">
            <button class="bg-gray-700 text-gray-400 px-4 py-2 rounded hover:bg-gray-600 mr-2" onclick="closeEditUsernameModal()">İptal</button>
            <button class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Kaydet</button>
        </div>
        </form>
  </div>
</div>

<div id="editEmailModal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-60 z-50 hidden">
  <div class="bg-gray-800 text-white rounded-lg shadow-lg p-6 w-full lg:w-1/3">
      <h2 class="text-xl font-semibold mb-4">E-Posta Adresini Düzenle</h2>
      <form id="email">
      <input class="w-full p-2 rounded bg-gray-700 text-sm" type="email" placeholder="Yeni E-Posta Adresi" id="newEmail">
      <div class="flex justify-end mt-4">
          <button class="bg-gray-700 text-gray-400 px-4 py-2 rounded hover:bg-gray-600 mr-2" onclick="closeEditEmailModal()">İptal</button>
          <button class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Kaydet</button>
      </div>
      </form>
  
  </div>
</div>

<div id="editPasswordModal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-60 z-50 hidden">
  <div class="bg-gray-800 text-white rounded-lg shadow-lg p-6 w-full lg:w-1/3">
      <h2 class="text-xl font-semibold mb-4">Şifreyi Değiştir</h2>
      <form id="password">
        <div class="space-y-3">
          <input class="w-full p-2 rounded bg-gray-700 text-sm" type="password" id="oldPassword" placeholder="Eski Şifre" disabled>
          <input class="w-full p-2 rounded bg-gray-700 text-sm" type="password" id="newPassword" placeholder="Yeni Şifre">
          <input class="w-full p-2 rounded bg-gray-700 text-sm" type="password" id="newPassword2" placeholder="Yeni Şifre Tekrar" disabled>  
        </div>
        
        <div class="flex justify-end mt-4">
            <button class="bg-gray-700 text-gray-400 px-4 py-2 rounded hover:bg-gray-600 mr-2" onclick="closeEditPasswordModal()">İptal</button>
            <button class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Kaydet</button>
        </div>
      </form>
  </div>
</div>

<div id="profilePhotoModal" class="fixed inset-0 flex items-center justify-center bg-black bg-opacity-60 z-50 hidden">
  <div class="bg-gray-800 text-white rounded-lg shadow-lg p-6 w-full lg:w-1/3">
      <img src="<%- user.profilePhoto %>" alt="Profil Fotoğrafın">
      <form id="profilePhoto">
        <input class="w-full p-2 rounded bg-gray-700 text-sm" id="pp" type="file" accept="image/jpeg, image/png, image/jpg, image/gif">
      
        <div class="flex justify-end mt-4">
            <button class="bg-gray-700 text-gray-400 px-4 py-2 rounded hover:bg-gray-600 mr-2" onclick="closeEditPPModal()">İptal</button>
            <button class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700">Kaydet</button>
        </div>
  
      </form>
  </div>
</div>

<!-- Script -->
<script>
function openSettingsModal() {
  document.getElementById('settingsModal').classList.remove('hidden');
}
function closeSettingsModal() {
    document.getElementById('settingsModal').classList.add('hidden');
  }

  // Display Name Modal
  function openEditDisplayNameModal() {
    document.getElementById('editDisplayNameModal').classList.remove('hidden');
  }
  function closeEditDisplayNameModal() {
    document.getElementById('editDisplayNameModal').classList.add('hidden');
  }
  function openEditPPModal() {
    document.getElementById('profilePhotoModal').classList.remove('hidden');
  }
  function closeEditPPModal() {
    document.getElementById('profilePhotoModal').classList.add('hidden');
  }
  // Username Modal
  function openEditUsernameModal() {
    document.getElementById('editUsernameModal').classList.remove('hidden');
  }
  function closeEditUsernameModal() {
    document.getElementById('editUsernameModal').classList.add('hidden');
  }

  // Email Modal
  function openEditEmailModal() {
    document.getElementById('editEmailModal').classList.remove('hidden');
  }
  function closeEditEmailModal() {
    document.getElementById('editEmailModal').classList.add('hidden');
  }

  // Password Modal
  function openEditPasswordModal() {
    document.getElementById('editPasswordModal').classList.remove('hidden');
  }
  function closeEditPasswordModal() {
    document.getElementById('editPasswordModal').classList.add('hidden');
  }

  document.getElementById('displayName').addEventListener('submit',(e) => {
    const displayName = document.getElementById('newDisplayName').value;
    e.preventDefault();
    fetch('/user/displayName', {
      method:'POST',
      headers: {
        'Content-Type':'application/json'
      },
      body:JSON.stringify({ displayName })
    }).then(x => console.log('display name changed'));
  });

  document.getElementById('username').addEventListener('submit',(e) => {
    const username = document.getElementById('newUsername').value;
    e.preventDefault();
    fetch('/user/username', {
      method:'POST',
      headers: {
        'Content-Type':'application/json'
      },
      body:JSON.stringify({ username })
    }).then(x => console.log('display name changed'));
  });

  document.getElementById('email').addEventListener('submit',(e) => {
    const email = document.getElementById('newEmail').value;
    e.preventDefault();
    fetch('/user/email', {
      method:'POST',
      headers: {
        'Content-Type':'application/json'
      },
      body:JSON.stringify({ email })
    }).then(x => x.status === 200 ? console.log('email changed') : console.log('email not changed'));
  });

  document.getElementById('password').addEventListener('submit',(e) => {
    e.preventDefault();
    const password = document.getElementById('newPassword').value;
    fetch('/user/password', {
      method:'POST',
      headers: {
        'Content-Type':'application/json'
      },
      body:JSON.stringify({ password })
    }).then(x => console.log('display name changed'));
  });

  document.getElementById('profilePhoto').addEventListener('submit', (e) => {
  e.preventDefault();

  const file = document.getElementById('pp').files[0];

  if(file) {
    const reader = new FileReader();
    
    reader.onload = function(event) {
      const profilePhoto = event.target.result; // Base64 string

      // fetch çağrısını dosya okuma işlemi tamamlandıktan sonra yapıyoruz
      fetch('/user/profilePhoto', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ pp: profilePhoto })
      }).then(x => x.status === 200 ? console.log('Photo uploaded') : console.log('Photo not uploaded'));
    };

    reader.readAsDataURL(file); // Base64 formatında okumayı başlatır
  }
});


</script>
