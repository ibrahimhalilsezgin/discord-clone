<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IboCord</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="flex h-screen overflow-hidden bg-gray-800 text-white">

    <!-- Sol Sidebar -->
<%- include("./layouts/sidebar.ejs") %>

    <div id="main" class="flex flex-grow h-screen">
        <!-- Kanal Listesi -->
        <div id="channel-bar" class="bg-gray-900 w-60 p-5">
            <%- include("./components/left-bottom.ejs") %>
        </div>

        <!-- Chat Alanı -->
        <div id="chat-area" class="flex flex-col flex-grow bg-gray-800">
            <div id="chat-header" class="flex items-center bg-gray-900 p-2 border-b border-gray-700"></div>
            <div id="messages" class="flex-grow p-2 overflow-y-auto"></div>
            <div id="message-input" class="flex p-2 bg-gray-700">
                <input id="input-field" type="text" class="flex-grow p-2 bg-gray-800 text-white rounded mr-2 disabled:text-slate-500" placeholder="Bir Sunucuya Gir" disabled>
            </div>
        </div>

        <!-- Sağ Kullanıcı Listesi -->
        <div id="user-list" class="bg-gray-900 w-60 p-5 border-l border-gray-700">

            <!-- Diğer kullanıcılar buraya eklenebilir -->
        </div>
    </div>
    <%- include("./layouts/settingsModal.ejs") %>
</body>
</html>
<%- include("./components/heartbeat.ejs") %>
<script>
    function fetchUserStatus(userElement) {
        const userId = userElement.getAttribute('data-id');

        fetch(`/status/${userId}`)
            .then(response => response.json())
            .then(data => {
                const statusElement = userElement.querySelector('.status');
                const userStatusDiv = userElement.querySelector('.user-status');

                if (data.status) {
                    if (data.status === 'active') {
                        userStatusDiv.classList.remove('user-status-offline');
                        userStatusDiv.classList.add('user-status-online');  // Offline sınıfını kaldır
                    } else {
                        userStatusDiv.classList.add('user-status-offline'); // Offline sınıfını ekle
                        
                    }
                } else {
                    userStatusDiv.classList.remove('user-status-online'); // Offline sınıfını ekle
                    userStatusDiv.classList.add('user-status-offline'); // Offline sınıfını ekle
                }
            })
            .catch(error => {
                console.error('Error fetching status:', error);
            });
    }

    // İlk durum kontrolü ve ardından her 5 saniyede bir kontrol et
    const userElements = document.querySelectorAll('.user');
    userElements.forEach(userElement => {
        fetchUserStatus(userElement); // İlk durumu kontrol et
        setInterval(() => fetchUserStatus(userElement), 5000); // 5 saniyede bir durumu kontrol et
    });
</script>
<script>
    
    
    function openSettingsModal() {
        document.getElementById('settingsModal').classList.remove('hidden')
    }
</script>