<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IboCord</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
</head>
<body class="flex h-screen overflow-hidden bg-gray-800 text-white">

    <!-- Sol Sidebar -->
<%- include("./layouts/sidebar.ejs") %>

    <div id="main" class="flex flex-grow h-screen">
        <!-- Kanal Listesi -->
        <div id="channel-bar" class="bg-gray-900 w-60 p-5">
            <%- include("./components/left-bottom.ejs") %>
        </div>

        <!-- Chat Alanı -->
        <div id="chat-area" class="flex flex-col flex-grow bg-gray-800">
            <div id="chat-header" class="flex items-center bg-gray-900 p-2 border-b border-gray-700">
            </div>
            <div id="messages" class="flex-grow p-2 overflow-y-auto">
                <!-- Diğer mesajlar buraya eklenebilir -->
            </div>
            <div id="message-input" class="flex p-2 bg-gray-700">
                <input id="input-field" type="text" class="flex-grow p-2 bg-gray-800 text-white rounded mr-2" placeholder="Mesaj yaz...">
                <button id="send-btn" class="bg-blue-600 p-2 rounded hover:bg-blue-500 transition duration-300">Gönder</button>
            </div>
        </div>

        <!-- Sağ Kullanıcı Listesi -->
        <div id="user-list" class="bg-gray-900 w-60 p-5 border-l border-gray-700">

            <!-- Diğer kullanıcılar buraya eklenebilir -->
        </div>
    </div>
    <%- include("./layouts/settingsModal.ejs") %>
</body>
</html>


<script>
    function openSettingsModal() {
        document.getElementById('settingsModal').classList.remove('hidden')
    }
</script>